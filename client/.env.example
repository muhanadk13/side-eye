# Where the SIDE EYE game server lives.
#
# Leave this UNSET for local dev and for the all-in-one deploy (Docker) — the
# client then talks to whatever origin served it.
#
# Set it only when the client is hosted separately from the server, which is the
# case on Netlify: a static host cannot hold a WebSocket open, so the client
# needs to know the real server's origin.
#
# VITE_SERVER_URL=https://side-eye-server.onrender.com
